#!/bin/sh

# OrcaX1 daemon: serves the in-browser slicer UI and bridges it to the
# printer's MQTT broker, camera and SD card.
#
# Everything lives on the SD card under /mnt/sdcard/orcax1. The SD card is
# FAT32 mounted without exec permission, so the binary is copied to /tmp
# (tmpfs) before it is started.
#
# Optional overrides: /mnt/sdcard/orcax1/orcax1d.conf, a shell fragment that
# sets ORCAX1D_* variables (see `orcax1d --help`), for example
#   ORCAX1D_LISTEN=0.0.0.0:8443
#   ORCAX1D_NO_REDIRECT=true

BASE=/mnt/sdcard/orcax1
SRC_BIN=$BASE/orcax1d
RUN_DIR=/tmp/orcax1d
RUN_BIN=$RUN_DIR/orcax1d
PIDFILE=/var/run/orcax1d.pid
LOG=/tmp/orcax1d.log

start() {
	printf "Starting orcax1d: "
	if [ ! -f "$SRC_BIN" ]; then
		echo "not installed ($SRC_BIN missing)"
		return 1
	fi
	mkdir -p "$RUN_DIR" "$BASE/state"
	cp "$SRC_BIN" "$RUN_BIN.new" && chmod 755 "$RUN_BIN.new" && mv "$RUN_BIN.new" "$RUN_BIN" || {
		echo "FAIL (copy)"
		return 1
	}
	[ -f "$LOG" ] && mv "$LOG" "$LOG.old"
	if [ -f "$BASE/orcax1d.conf" ]; then
		set -a
		. "$BASE/orcax1d.conf"
		set +a
	fi
	export ORCAX1D_WEB_ROOT="${ORCAX1D_WEB_ROOT:-$BASE/www}"
	export ORCAX1D_STATE_DIR="${ORCAX1D_STATE_DIR:-$BASE/state}"
	# The shell execs the daemon, so the pid written by -m is the daemon's.
	start-stop-daemon -S -m -b -N 10 -p "$PIDFILE" --exec /bin/sh -- \
		-c "exec $RUN_BIN >>$LOG 2>&1"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping orcax1d: "
	start-stop-daemon -K -q -p "$PIDFILE"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	rm -f "$PIDFILE"
}

restart() {
	stop
	sleep 1
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
