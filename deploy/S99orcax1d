#!/bin/sh

# OrcaX1 daemon: serves the in-browser slicer UI and bridges it to the
# printer's MQTT broker, camera and SD card.
#
# The release (web UI, install.sh) lives on the SD card under
# /mnt/sdcard/orcax1. Everything that runs as root or holds secrets lives on
# internal flash under /userdata/bin/orcax1, out of reach of the SD card's FTPS
# server (which anyone with the LAN access code can use):
#   orcax1d        the binary (install.sh copies it here from the SD card)
#   orcax1d.conf   optional overrides, a shell fragment that sets ORCAX1D_*
#                  variables (see `orcax1d --help`), for example
#                    ORCAX1D_LISTEN=0.0.0.0:8443
#                    ORCAX1D_NO_REDIRECT=true
#   state/         certificates, sessions, settings and their credentials

BASE=/mnt/sdcard/orcax1
HOME_DIR=/userdata/bin/orcax1
RUN_BIN=$HOME_DIR/orcax1d
CONF=$HOME_DIR/orcax1d.conf
PIDFILE=/var/run/orcax1d.pid
LOG=/tmp/orcax1d.log

start() {
	printf "Starting orcax1d: "
	if [ ! -x "$RUN_BIN" ]; then
		echo "not installed ($RUN_BIN missing; run $BASE/install.sh)"
		return 1
	fi
	mkdir -p "$HOME_DIR/state"
	[ -f "$LOG" ] && mv "$LOG" "$LOG.old"
	if [ -f "$CONF" ]; then
		set -a
		. "$CONF"
		set +a
	fi
	export ORCAX1D_WEB_ROOT="${ORCAX1D_WEB_ROOT:-$BASE/www}"
	export ORCAX1D_STATE_DIR="${ORCAX1D_STATE_DIR:-$HOME_DIR/state}"
	# The shell execs the daemon, so the pid written by -m is the daemon's.
	start-stop-daemon -S -m -b -N 10 -p "$PIDFILE" --exec /bin/sh -- \
		-c "exec $RUN_BIN >>$LOG 2>&1"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping orcax1d: "
	start-stop-daemon -K -q -p "$PIDFILE"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	rm -f "$PIDFILE"
}

restart() {
	stop
	sleep 1
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
